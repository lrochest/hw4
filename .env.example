# Copy this file to .env (in hw4/) and fill in your own values.
# Never commit the real .env.

# Portkey API key used by the shop agent (model: gpt-6-astra via https://api.portkey.ai/v1)
PORTKEY_API_KEY=your-portkey-api-key-here

# Set to 1 when serving over HTTPS so the login cookie is only sent encrypted.
COOKIE_SECURE=0
